# Copy this file to .env and fill in the values.
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Where to write the boundary CSV. Relative paths are relative to this folder.
# Must be the coordinates.csv that computer_end_code.py reads
# (it reads coordinates.csv from the folder you run it in).
CSV_PATH=coordinates.csv

# How often to check Supabase for changes, in seconds
POLL_SECONDS=10
